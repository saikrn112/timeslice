<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Local-first, offline app: no sandbox so it can read/write its own Application Support DB
       and run the global-hotkey event tap (gated by the Accessibility permission, not an entitlement). -->
  <key>com.apple.security.app-sandbox</key>
  <false/>
</dict>
</plist>
