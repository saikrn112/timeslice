# SwiftPM build output
.build/
dist/

# Resolved dependencies (none currently; regenerated by `swift package resolve`)
Package.resolved

# macOS
.DS_Store

# Xcode / SwiftPM local state
*.xcodeproj
.swiftpm/

# Generated by XcodeGen from the `info.properties` in ios/project.yml, which is the source of
# truth. Committing these invites editing the copy that gets overwritten on the next generate.
ios/Timeslice/Info.plist
ios/TimesliceWidgets/Info.plist

# Editor swap files
*.swp
*.swo

# Raw screen recordings (only the exported GIFs are tracked)
docs/media/*.mov

# Local OAuth credentials — never commit. The client id is baked into the build at release
# time; the secret stays on this machine.
/tmp
*.client_secret.json
client_secret*.json
